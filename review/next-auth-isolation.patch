+// Local browser regression only. All Supabase requests are mocked, no email is sent.
+/* eslint-disable @typescript-eslint/no-require-imports -- Node regression runner. */
+const { chromium } = require('playwright');
+const assert = require('node:assert/strict');
+const origin = 'http://127.0.0.1:3100';
+const user = { id: '11111111-1111-4111-8111-111111111111', aud: 'authenticated', role: 'authenticated', email: 'test@example.invalid', app_metadata: {}, user_metadata: {}, created_at: new Date().toISOString() };
+const jwt = Buffer.from(JSON.stringify({ alg: 'HS256', typ: 'JWT' })).toString('base64url') + '.' + Buffer.from(JSON.stringify({ sub: user.id, role: 'authenticated', exp: Math.floor(Date.now()/1000)+3600 })).toString('base64url') + '.fake-test-signature';
+const guest = JSON.stringify([{id:'guest',name:'GUEST-ONLY',quantity:1,category:'自用',bought:false}]);
+(async () => {
+  const bundled = process.env.USE_BUNDLED_CHROMIUM ? require('@sparticuz/chromium') : null;
+  for (const viewport of [{width:1440,height:900},{width:390,height:844}]) {
+    const browser = await chromium.launch({headless:true,args:bundled ? bundled.args : ['--no-sandbox'],...(bundled ? {executablePath:await bundled.executablePath()} : {})});
+    try {
+      const context = await browser.newContext({viewport});
+      let recoveryRedirect;
+      let mutationMode = 'empty', inserts = 0;
+      let readFailure = '', releaseItems, itemRequested;
+      const itemRequestEntered = new Promise(resolve=>{itemRequested=resolve});
+      await context.route('**/*', async route => {
+        const url = new URL(route.request().url());
+        if (url.origin === origin) return route.continue();
+        if (url.hostname !== 'isolated-test.supabase.co') return route.abort();
+        if ((readFailure === 'auth' && url.pathname.endsWith('/user')) ||
+            (readFailure === 'trips' && url.pathname === '/rest/v1/trips') ||
+            (readFailure === 'items' && url.pathname === '/rest/v1/shopping_items' && route.request().method()==='GET')) {
+          return route.fulfill({status:readFailure==='auth'?400:503,contentType:'application/json',body:JSON.stringify({message:'synthetic read failure'})});
+        }
+        if (readFailure === 'slow-items' && url.pathname === '/rest/v1/shopping_items' && route.request().method()==='GET') {
+          itemRequested();
+          await new Promise(resolve=>{releaseItems=resolve});
+        }
+        let body = {};
