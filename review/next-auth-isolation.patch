new file mode 100644
index 0000000..a9d1b84
--- /dev/null
+++ b/tests/auth-callback.cjs
@@ -0,0 +1,43 @@
+// Run the actual compiled handler with a synthetic Auth adapter; no network.
+/* eslint-disable @typescript-eslint/no-require-imports -- Node regression runner. */
+const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict'),ts=require('typescript');
+const source=fs.readFileSync('app/auth/callback/route.ts','utf8');
+const compiled=ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
+let mode='success',exchanges=0;
+const exportsObject={};
+vm.runInNewContext(compiled,{exports:exportsObject,URL,require:name=>{
+ if(name==='next/server')return {NextResponse:{redirect:url=>new Response(null,{status:307,headers:{Location:String(url)}})}};
+ if(name==='@/utils/supabase/server')return {createClient:async()=>{
+  if(mode==='client-throw')throw Error('synthetic secret');
+  return {auth:{exchangeCodeForSession:async code=>{
+   assert.equal(code,'synthetic-code');exchanges++;
+   if(mode==='throw')throw Error('synthetic secret');
+   return {error:mode==='error'?{message:'synthetic secret'}:null};
+  }}};
+ }};
+ throw Error('Unexpected import '+name);
+}});
+const origin='https://tripin.example';
+(async()=>{
+ let checks=0;
+ const verify=async(next,expected,code=true)=>{
+  const url=new URL('/auth/callback',origin);
+  if(code)url.searchParams.set('code','synthetic-code');
+  if(next!==undefined)url.searchParams.set('next',next);
+  const response=await exportsObject.GET(new Request(url));
+  assert.equal(response.status,307);
+  assert.equal(response.headers.get('location'),origin+expected);
+  assert.equal(response.headers.get('cache-control'),'private, no-store');
+  assert(!response.headers.get('location').includes('synthetic'));
+  checks++;
+ };
+ await verify(undefined,'/');
+ await verify('/reset-password','/reset-password');
+ await verify('/reset-password?source=email#form','/reset-password?source=email#form');
+ for(const next of ['@attacker.invalid','https://attacker.invalid','//attacker.invalid','/\\attacker.invalid','javascript:alert(1)','https://tripin.example/reset-password','/\n/attacker.invalid',''])await verify(next,'/');
+ const before=exchanges;
+ await verify('/reset-password','/login?error=auth_callback_error',false);
+ assert.equal(exchanges,before,'Missing code must not invoke Auth');
+ for(mode of ['error','throw','client-throw'])await verify('/reset-password','/login?error=auth_callback_error');
+ console.log('PASS '+checks+' callback redirect, error and no-cache cases');
+})().catch(error=>{console.error(error);process.exitCode=1});
