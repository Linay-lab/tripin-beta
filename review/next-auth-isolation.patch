+        else if (url.pathname.endsWith('/user')) body = user;
+        else if (url.pathname.endsWith('/recover')) recoveryRedirect = url.searchParams.get('redirect_to');
+        else if (url.pathname === '/rest/v1/trips') body = {id:'trip-a',owner_id:user.id,name:'PRIVATE-TRIP',currency:'TWD'};
+        else if (url.pathname === '/rest/v1/shopping_items') {
+          const method = route.request().method();
+          if (method === 'GET') body = [{id:'cloud-a',created_by:user.id,name:'PRIVATE-CLOUD-ITEM',quantity:1,category:'自用',bought:false}];
+          else if (mutationMode === 'error') return route.fulfill({status:503,contentType:'application/json',body:JSON.stringify({message:'synthetic failure'})});
+          else if (mutationMode === 'denied') return route.fulfill({status:403,contentType:'application/json',body:JSON.stringify({code:'42501',message:'synthetic denial'})});
+          else if (mutationMode === 'empty') body = [];
+          else if (method === 'POST') {
+            inserts++;
+            await new Promise(resolve=>setTimeout(resolve,300));
+            body = {...route.request().postDataJSON(),id:'inserted-item'};
+          } else body = {id:'cloud-a'};
+        }
+        await route.fulfill({status:200,contentType:'application/json',body:JSON.stringify(body)});
+      });
+      const page = await context.newPage();
+      await page.goto(origin+'/login');
+      await page.evaluate(value => localStorage.setItem('souvenir-items',value),guest);
+      await page.locator('input[type=email]').fill('test@example.invalid');
+      await page.getByRole('button',{name:'忘記密碼？'}).click();
+      await page.getByText('重設密碼信已寄出',{exact:false}).waitFor();
+      assert.equal(recoveryRedirect,origin+'/auth/callback?next=/reset-password');
+      await page.locator('input[type=password]').fill('synthetic-test-password');
