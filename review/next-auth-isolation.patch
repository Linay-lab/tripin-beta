diff --git a/tests/auth-isolation.cjs b/tests/auth-isolation.cjs
new file mode 100644
index 0000000..e932cd9
--- /dev/null
+++ b/tests/auth-isolation.cjs
@@ -0,0 +1,99 @@
+// Local browser regression only. All Supabase requests are mocked, no email is sent.
+/* eslint-disable @typescript-eslint/no-require-imports -- Node regression runner. */
+const { chromium } = require('playwright');
+const assert = require('node:assert/strict');
+const origin = 'http://127.0.0.1:3100';
+const user = { id: '11111111-1111-4111-8111-111111111111', aud: 'authenticated', role: 'authenticated', email: 'test@example.invalid', app_metadata: {}, user_metadata: {}, created_at: new Date().toISOString() };
+const jwt = Buffer.from(JSON.stringify({ alg: 'HS256', typ: 'JWT' })).toString('base64url') + '.' + Buffer.from(JSON.stringify({ sub: user.id, role: 'authenticated', exp: Math.floor(Date.now()/1000)+3600 })).toString('base64url') + '.fake-test-signature';
+const guest = JSON.stringify([{id:'guest',name:'GUEST-ONLY',quantity:1,category:'自用',bought:false}]);
+(async () => {
+  const bundled = process.env.USE_BUNDLED_CHROMIUM ? require('@sparticuz/chromium') : null;
+  for (const viewport of [{width:1440,height:900},{width:390,height:844}]) {
+    const browser = await chromium.launch({headless:true,args:bundled ? bundled.args : ['--no-sandbox'],...(bundled ? {executablePath:await bundled.executablePath()} : {})});
+    try {
+      const context = await browser.newContext({viewport});
+      let recoveryRedirect;
+      let mutationMode = 'empty', inserts = 0;
+      await context.route('**/*', async route => {
+        const url = new URL(route.request().url());
+        if (url.origin === origin) return route.continue();
+        if (url.hostname !== 'isolated-test.supabase.co') return route.abort();
+        let body = {};
+        if (url.pathname.endsWith('/token')) body = {access_token:jwt,refresh_token:'fake-refresh',token_type:'bearer',expires_in:3600,user};
+        else if (url.pathname.endsWith('/user')) body = user;
+        else if (url.pathname.endsWith('/recover')) recoveryRedirect = url.searchParams.get('redirect_to');
+        else if (url.pathname === '/rest/v1/trips') body = {id:'trip-a',owner_id:user.id,name:'PRIVATE-TRIP',currency:'TWD'};
+        else if (url.pathname === '/rest/v1/shopping_items') {
+          const method = route.request().method();
+          if (method === 'GET') body = [{id:'cloud-a',created_by:user.id,name:'PRIVATE-CLOUD-ITEM',quantity:1,category:'自用',bought:false}];
+          else if (mutationMode === 'error') return route.fulfill({status:503,contentType:'application/json',body:JSON.stringify({message:'synthetic failure'})});
+          else if (mutationMode === 'denied') return route.fulfill({status:403,contentType:'application/json',body:JSON.stringify({code:'42501',message:'synthetic denial'})});
+          else if (mutationMode === 'empty') body = [];
+          else if (method === 'POST') {
+            inserts++;
+            await new Promise(resolve=>setTimeout(resolve,300));
+            body = {...route.request().postDataJSON(),id:'inserted-item'};
+          } else body = {id:'cloud-a'};
+        }
+        await route.fulfill({status:200,contentType:'application/json',body:JSON.stringify(body)});
+      });
+      const page = await context.newPage();
+      await page.goto(origin+'/login');
+      await page.evaluate(value => localStorage.setItem('souvenir-items',value),guest);
+      await page.locator('input[type=email]').fill('test@example.invalid');
+      await page.getByRole('button',{name:'忘記密碼？'}).click();
+      await page.getByText('重設密碼信已寄出',{exact:false}).waitFor();
+      assert.equal(recoveryRedirect,origin+'/auth/callback?next=/reset-password');
+      await page.locator('input[type=password]').fill('synthetic-test-password');
+      await page.getByRole('button',{name:'登入旅購',exact:true}).click();
+      await page.getByRole('heading',{name:'PRIVATE-CLOUD-ITEM'}).waitFor();
+      assert.equal(await page.evaluate(()=>localStorage.getItem('souvenir-items')),guest);
+      // A successful HTTP response with zero affected rows must not mark as bought.
+      await page.getByRole('button',{name:'標記為已購買',exact:true}).click();
+      await page.locator('p[role=alert]').waitFor();
+      assert.equal(await page.getByRole('button',{name:'標記為已購買',exact:true}).count(),1);
+      mutationMode = 'success';
+      await page.getByRole('button',{name:'標記為已購買',exact:true}).click();
+      await page.getByRole('button',{name:'標記為未購買',exact:true}).waitFor();
+      mutationMode = 'denied';
+      await page.getByTitle('編輯商品').click();
+      await page.getByPlaceholder('例如：雪鹽金楚糕').fill('EDITED-ITEM');
+      await page.getByRole('button',{name:'儲存修改',exact:true}).click();
+      await page.locator('p[role=alert]').waitFor();
+      assert.equal(await page.getByPlaceholder('例如：雪鹽金楚糕').inputValue(),'EDITED-ITEM');
+      assert.equal(await page.getByRole('heading',{name:'PRIVATE-CLOUD-ITEM'}).count(),1);
+      mutationMode = 'success';
+      await page.getByRole('button',{name:'儲存修改',exact:true}).click();
+      await page.getByRole('heading',{name:'EDITED-ITEM',exact:true}).waitFor();
+      await page.getByRole('button',{name:'＋ 新增商品',exact:true}).click();
+      await page.getByPlaceholder('例如：雪鹽金楚糕').fill('NEW-ITEM');
+      await page.getByRole('button',{name:'加入清單',exact:true}).evaluate(button=>{button.click();button.click()});
+      await page.getByRole('heading',{name:'NEW-ITEM',exact:true}).waitFor();
+      assert.equal(inserts,1,'Repeated submit created duplicate requests');
+      page.on('dialog',dialog=>dialog.accept());
+      mutationMode = 'error';
+      await page.getByRole('article').filter({has:page.getByRole('heading',{name:'EDITED-ITEM',exact:true})}).getByTitle('刪除商品').click();
+      await page.locator('p[role=alert]').waitFor();
+      assert.equal(await page.getByRole('heading',{name:'EDITED-ITEM',exact:true}).count(),1);
+      mutationMode = 'empty';
+      const deletionResponse = page.waitForResponse(response=>response.request().method()==='DELETE');
+      await page.getByRole('article').filter({has:page.getByRole('heading',{name:'EDITED-ITEM',exact:true})}).getByTitle('刪除商品').click();
+      await deletionResponse;
+      await page.locator('button[aria-label="標記為未購買"]:enabled').waitFor();
+      await page.locator('p[role=alert]').waitFor();
+      assert.equal(await page.getByRole('heading',{name:'EDITED-ITEM',exact:true}).count(),1);
+      mutationMode = 'success';
+      await page.getByRole('article').filter({has:page.getByRole('heading',{name:'EDITED-ITEM',exact:true})}).getByTitle('刪除商品').click();
+      await page.getByRole('heading',{name:'EDITED-ITEM',exact:true}).waitFor({state:'detached'});
+      await page.getByRole('button',{name:'登出',exact:true}).click();
+      await page.waitForURL(origin+'/login');
+      assert.equal(await page.evaluate(()=>localStorage.getItem('souvenir-items')),guest);
+      await page.goto(origin);
+      await page.getByRole('heading',{name:'GUEST-ONLY'}).waitFor();
+      assert.equal(await page.getByText('PRIVATE-CLOUD-ITEM').count(),0);
+      assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'Horizontal overflow');
+      console.log('PASS recovery/logout privacy, mutation failures, retries and duplicate-submit protection '+viewport.width+'px');
+      await context.close();
+    } finally { await browser.close(); }
+  }
+})().catch(error=>{console.error(error);process.exitCode=1});
