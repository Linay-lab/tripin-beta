--- /dev/null
+++ b/tests/run-auth-review.cjs
@@ -0,0 +1,34 @@
+// Start an isolated Next server and run the complete Auth review suite.
+/* eslint-disable @typescript-eslint/no-require-imports -- Node regression runner. */
+const {spawn}=require('node:child_process'),fs=require('node:fs'),path=require('node:path');
+const root=path.resolve(__dirname,'..');
+const lock=require('../package-lock.json');
+for(const name of ['next','react','@supabase/ssr','@supabase/supabase-js','@supabase/auth-js']){
+ const installed=JSON.parse(fs.readFileSync(path.join(root,'node_modules',name,'package.json'),'utf8')).version;
+ if(installed!==lock.packages['node_modules/'+name].version)throw Error('Run npm ci first: dependency differs from lockfile: '+name);
+}
+const env={...process.env,NEXT_PUBLIC_SUPABASE_URL:'https://isolated-test.supabase.co',NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:'sb_publishable_fake_test_only',NEXT_TELEMETRY_DISABLED:'1'};
+const run=file=>new Promise((resolve,reject)=>{
+ const child=spawn(process.execPath,[path.join(__dirname,file)],{cwd:root,env,stdio:'inherit'});
+ child.once('error',reject);child.once('exit',code=>code===0?resolve():reject(Error(file+' failed with '+code)));
+});
+(async()=>{
+ // Refuse an occupied port instead of testing an unknown server.
+ const net=require('node:net');
+ await new Promise((resolve,reject)=>{const probe=net.createServer();probe.once('error',reject);probe.listen(3100,'127.0.0.1',()=>probe.close(resolve))});
+ const server=spawn(process.execPath,[require.resolve('next/dist/bin/next'),'dev','--hostname','127.0.0.1','--port','3100'],{cwd:root,env,stdio:'ignore'});
+ try{
+  let started=false,spawnError;
+  server.once('error',error=>{spawnError=error});
+  const deadline=Date.now()+90000;
+  while(Date.now()<deadline){
+   if(spawnError)throw spawnError;
+   if(server.exitCode!==null)throw Error('Isolated Next server exited');
+   try{const response=await fetch('http://127.0.0.1:3100/login',{signal:AbortSignal.timeout(2000)});if(response.ok){started=true;break}}catch{}
+   await new Promise(resolve=>setTimeout(resolve,300));
+  }
+  if(!started)throw Error('Isolated Next server did not become ready');
+  for(const file of ['auth-callback.cjs','password-reset.cjs','session-switch.cjs','auth-isolation.cjs'])await run(file);
+  console.log('PASS full isolated Auth review using locked application dependencies');
+ }finally{server.kill('SIGTERM')}
+})().catch(error=>{console.error(error.message);process.exitCode=1});
diff --git a/tests/session-switch.cjs b/tests/session-switch.cjs
new file mode 100644
index 0000000..e59a8c8
--- /dev/null
+++ b/tests/session-switch.cjs
@@ -0,0 +1,73 @@
+// Browser-only synthetic Auth/REST responses. No real keys, passwords or emails.
+/* eslint-disable @typescript-eslint/no-require-imports -- Node regression runner. */
+const {chromium}=require('playwright');
+const assert=require('node:assert/strict');
+const origin='http://127.0.0.1:3100';
+const users=['11111111-1111-4111-8111-111111111111','22222222-2222-4222-8222-222222222222'].map((id,i)=>({id,aud:'authenticated',role:'authenticated',email:`user${i}@example.invalid`,app_metadata:{},user_metadata:{},created_at:new Date().toISOString()}));
+const tokens=users.map(user=>Buffer.from(JSON.stringify({alg:'HS256',typ:'JWT'})).toString('base64url')+'.'+Buffer.from(JSON.stringify({sub:user.id,role:user.role,exp:Math.floor(Date.now()/1000)+3600})).toString('base64url')+'.synthetic-signature');
+const guest='[]';
+(async()=>{
+ const bundled=process.env.USE_BUNDLED_CHROMIUM?require('@sparticuz/chromium'):null;
+ for(const viewport of [{width:1440,height:900},{width:390,height:844}]){
+  const browser=await chromium.launch({headless:true,args:bundled?bundled.args:['--no-sandbox'],...(bundled?{executablePath:await bundled.executablePath()}:{})});
+  try{
+   const context=await browser.newContext({viewport});
+   let rejectAuth=false;
+   await context.route('**/*',async route=>{
+    const request=route.request(),url=new URL(request.url());
+    if(url.origin===origin)return route.continue();
+    if(url.hostname!=='isolated-test.supabase.co')return route.abort();
+    const token=request.headers().authorization?.replace('Bearer ','');
+    let index=tokens.indexOf(token);if(index<0)index=0;
+    let body={};
+    if(url.pathname.endsWith('/token')){
+     index=users.findIndex(user=>user.email===request.postDataJSON().email);
+     assert(index>=0);
+     body={access_token:tokens[index],refresh_token:'fake-refresh-'+index,token_type:'bearer',expires_in:3600,user:users[index]};
+    }else if(url.pathname.endsWith('/user')){
+     if(rejectAuth)return route.fulfill({status:401,contentType:'application/json',body:JSON.stringify({code:'bad_jwt',message:'synthetic expired session'})});
+     body=users[index];
+    }else if(url.pathname==='/rest/v1/trips'){
+     assert.equal(url.searchParams.get('owner_id'),'eq.'+users[index].id,'Stale trip owner sent with new account token');
+     body={id:'trip-'+index,owner_id:users[index].id,name:'TRIP-'+index,currency:'TWD'};
+    }else if(url.pathname==='/rest/v1/shopping_items'){
+     assert.equal(url.searchParams.get('trip_id'),'eq.trip-'+index,'Stale trip sent with new account token');
+     body=[{id:'item-'+index,name:'PRIVATE-ITEM-'+index,quantity:1,category:'自用',bought:false,revision:0}];
+    }
+    await route.fulfill({status:200,contentType:'application/json',body:JSON.stringify(body)});
+   });
+   const first=await context.newPage(),second=await context.newPage();
+   const login=async(page,index)=>{
+    await page.goto(origin+'/login');
+    await page.locator('input[type=email]').fill(users[index].email);
+    await page.locator('input[type=password]').fill('synthetic-password');
+    await page.getByRole('button',{name:'登入旅購',exact:true}).click();
+    await page.getByRole('heading',{name:'PRIVATE-ITEM-'+index,exact:true}).waitFor();
+   };
+   await first.goto(origin+'/login');
+   await first.evaluate(value=>localStorage.setItem('souvenir-items',value),guest);
+   await login(first,0);
+   await login(second,1);
+   await first.getByRole('heading',{name:'PRIVATE-ITEM-1',exact:true}).waitFor();
+   assert.equal(await first.getByText('PRIVATE-ITEM-0',{exact:true}).count(),0);
+   assert.equal(await first.evaluate(()=>localStorage.getItem('souvenir-items')),guest);
+   // Same-user SIGNED_IN must not discard another tab's draft.
+   await first.getByRole('button',{name:'＋ 新增商品',exact:true}).click();
+   await first.getByPlaceholder('例如：雪鹽金楚糕').fill('UNSAVED-DRAFT');
+   await login(second,1);
+   assert.equal(await first.getByPlaceholder('例如：雪鹽金楚糕').inputValue(),'UNSAVED-DRAFT');
+   await second.getByRole('button',{name:'登出',exact:true}).click();
+   await second.waitForURL(origin+'/login');
+   await first.waitForURL(origin+'/login');
+   assert.equal(await first.evaluate(()=>localStorage.getItem('souvenir-items')),guest);
+   await login(first,0);
+   rejectAuth=true;
+   await first.reload();
+   await first.waitForFunction(()=>location.pathname==='/login'||document.querySelector('p[role=alert]'));
+   assert.equal(await first.getByText('PRIVATE-ITEM-0',{exact:true}).count(),0);
+   assert.equal(await first.getByRole('button',{name:'＋ 新增商品',exact:true}).count(),0);
+   assert.equal(await first.evaluate(()=>localStorage.getItem('souvenir-items')),guest);
+   console.log('PASS cross-tab account switch, same-user draft preservation, logout and rejected session '+viewport.width+'px');
+  }finally{await browser.close()}
+ }
+})().catch(error=>{console.error(error);process.exitCode=1});
